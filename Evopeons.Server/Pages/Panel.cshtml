@page
@inject Evopeons.Server.Services.PackageService PackageService
@inject Evopeons.Server.Services.DataService DataService
@{
    Layout = null;
    var version = PackageService.GetVersion();
    var fileSizeInMb = Evopeons.Server.Controllers.PackageController.MaxFileSize / 1000;
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Panel</title>
</head>
<body>
    <h1>UpdateServer Panel</h1>
    <ul>
        <li>Status: <strong>@PackageService.State (@((int)PackageService.State))</strong></li>
        <li>Current Version: <strong>@version</strong></li>
    </ul>
    <form method="post" action="@Url.Action("CreatePackage", "Package")" enctype="multipart/form-data" style="border: 1px solid red">
        <h2>Upload new package</h2>
        <div>
            <label>New Version</label>
            <input type="text" name="version" value="@(new Evopeons.Common.SemVersion(version.Major, version.Minor, version.Patch + 1))" />
        </div>

        <div>
            <label>Package Zip</label>
            <input type="file" name="file" />
            (Max: @fileSizeInMb.ToString("N0") mb)
        </div>

        <button type="submit">Upload</button>
    </form>
    <form method="post" action="@Url.Action("News", "Package")" enctype="multipart/form-data" style="border: 1px solid red">
        <h2>Save News</h2>
        <div>
            <label>New News</label>
            <textarea name="news">@DataService.GetGenericValue("News")</textarea>
        </div>

        <button type="submit">Save News</button>
    </form>
</body>
</html>